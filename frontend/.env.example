NEXT_PUBLIC_API_URL=http://localhost:8000

# Same Supabase project as the backend's SUPABASE_URL / SUPABASE_ANON_KEY.
# The anon key is safe for the browser — it carries no privileges of its own.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 only on a separate, demo-only deployment. Every backend call
# short-circuits before touching the network, so that deployment always
# shows the static preview and can never connect to anything real —
# regardless of NEXT_PUBLIC_API_URL above. Leave unset for local dev and
# any deployment meant to show real data.
NEXT_PUBLIC_DEMO_MODE=
