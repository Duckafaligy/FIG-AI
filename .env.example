# Copy to .env and fill in. .env is gitignored and must stay that way.

# --- Supabase ---------------------------------------------------------
# Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # bypasses RLS — server-side only, never in a browser

# Project Settings > Database > Connection string > Session pooler.
# NOT db.<ref>.supabase.co (retired) and NOT the transaction pooler on 6543
# (breaks prepared statements under SQLAlchemy pooling).
# The username includes the project ref. Percent-encode @ / ? # % : in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Run against a local SQLite file instead, ignoring DATABASE_URL:
# FIG_DATABASE_URL=sqlite:///./fig.db
# Refuse to start rather than falling back to SQLite:
# FIG_DB_STRICT=1

# --- AI ---------------------------------------------------------------
# The only LLM call in the pipeline (app/ai_explain.py). Everything works
# without it; findings keep the explanation the rule ships with.
ANTHROPIC_API_KEY=
# FIG_AI_EXPLAIN=0                  # keep the key, skip the calls

# --- Stripe -----------------------------------------------------------
# STRIPE_PRICE_ID is created by: python scripts/stripe_setup.py --write
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=              # only once you have a public https URL

# --- Auth -------------------------------------------------------------
# Signs the session cookie. Without it every restart signs everyone out.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
FIG_SESSION_SECRET=
# This email inherits the seeded account on first sign-in; everyone else gets
# an empty account of their own.
FIG_OWNER_EMAIL=
# FIG_SESSION_MAX_AGE=1209600

# --- App --------------------------------------------------------------
FIG_PUBLIC_URL=http://127.0.0.1:8000
# 1 = no sign-in, every request is the demo account. MUST be 0 in production.
# FIG_MAX_PAGES=40
# FIG_CRAWL_DELAY=0.8
# FIG_WORKERS=2
